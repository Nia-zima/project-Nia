@echo off
chcp 65001 > nul
setlocal EnableExtensions

set "PROJECT_ROOT=%~dp0"
if "%PROJECT_ROOT:~-1%"=="\" set "PROJECT_ROOT=%PROJECT_ROOT:~0,-1%"

set "VENV_PY=%PROJECT_ROOT%\.venv\Scripts\python.exe"
set "FRONTEND_DIR=%PROJECT_ROOT%\frontend"

echo.
echo =========================================
echo   NIA SYSTEM LAUNCHER (DEV MODE)
echo   ROOT: %PROJECT_ROOT%
echo   HOT RELOAD: ENABLED
echo =========================================
echo.

REM --- Safety Check ---
if not exist "%VENV_PY%" (
    echo [ERROR] Virtual Environment not found!
    echo Checked: "%VENV_PY%"
    pause
    exit /b 1
)

REM --- 1. Start API Server ---
echo [1/3] Starting Backend API (Dev Mode)...
start "NIA API (Dev)" cmd /k "cd /d "%PROJECT_ROOT%" && "%VENV_PY%" -m uvicorn backend.server:app --host 0.0.0.0 --port 8000 --reload"

REM --- 2. Start Frontend (Dev Mode) ---
echo [2/3] Starting Frontend (Dev Mode)...
rem No build step needed for dev
rem Use --hostname 0.0.0.0 to allow mobile/external access
start "NIA FRONTEND (Dev)" cmd /k "cd /d "%FRONTEND_DIR%" && npm run dev -- --hostname 0.0.0.0"

REM --- 3. Set up Tailscale Serve (Optional HTTPS) ---
echo [3/3] Setting up Tailscale Serve...
timeout /t 5 /nobreak > nul
tailscale serve --bg 3000 > nul 2>&1

REM --- 4. Open Browser ---
timeout /t 5 /nobreak > nul
echo.
echo =========================================
echo   DEV SYSTEM LAUNCHED!
echo   PC:     http://localhost:3000
echo   Mobile: https://zima11.taild5de64.ts.net
echo =========================================
echo Edit files and see changes instantly!
start http://localhost:3000

pause
exit /b 0
